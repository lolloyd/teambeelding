# TeamBeelding — Environment Variables
# Copy this file to .env.local and fill in your Firebase project credentials.
# NEVER commit .env.local or any file containing real credentials.

# ── Firebase Web App Config ─────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Firebase App Check ───────────────────────────────────────────────────────
# reCAPTCHA v3 site key (public — safe to expose in the browser).
# Leave empty to use the Emulator debug provider during local development.
VITE_FIREBASE_APP_CHECK_KEY=

# ── App behaviour ────────────────────────────────────────────────────────────
# Set to "true" only in local development to point at the Firebase Emulator Suite.
VITE_USE_EMULATORS=false

# ── Production domain ────────────────────────────────────────────────────────
# Your Namecheap cPanel domain, used for CORS and App Check allow-list.
VITE_PRODUCTION_DOMAIN=https://yourdomain.com
